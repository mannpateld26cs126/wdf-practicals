# Copy to .env and fill secrets
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_portal?schema=public
PORT=4000
JWT_ACCESS_TOKEN_SECRET=change_this_access_secret
JWT_REFRESH_TOKEN_SECRET=change_this_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
